---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Countdown from "../components/Countdown.jsx";
import SiteLayout from "../layouts/SiteLayout.astro";
import pageHtml from "../page.html?raw";

const homeContent = pageHtml
  .replace(/^<main class="relative">\s*/, "")
  .replace(/\s*<\/main>\s*$/, "")
  .replace(/<header[\s\S]*?<\/header>\s*/, "")
  .replace(/\s*<footer[\s\S]*?<\/footer>\s*/, "");
---

<SiteLayout basePath="./">
  <main class="relative">
    <SiteHeader basePath="./" />
    <Fragment set:html={homeContent} />
    <SiteFooter basePath="./" />
  </main>
  <Countdown client:load />
</SiteLayout>
