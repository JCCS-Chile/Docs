---
import "../styles/site.css";

const {
  basePath = "./",
  description = "Gobernanza, Resiliencia e Interoperabilidad Segura en el Ecosistema Sanitario. 12 de agosto 2026 · Universidad de los Andes · Las Condes, Santiago.",
  title = "JCCS 2026 — 3ª Jornada Chilena de Ciberseguridad en Salud",
} = Astro.props;

const siteUrl = "https://www.jornadacibersalud.cl";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL(`${basePath}assets/logos/jccs-2026-logo.png`, canonicalUrl).toString();
---

<!doctype html>
<html lang="es" class="__variable_33c280 __variable_a360ee __variable_93e2b9">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="ciberseguridad,salud,Chile,JCCS,jornada,2026" />
    <meta name="author" content="JCCS Chile" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#005A8D" />
    <meta name="application-name" content="JCCS 2026" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="JCCS 2026" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="JCCS 2026 — Jornada Chilena de Ciberseguridad en Salud" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="JCCS 2026 — Jornada Chilena de Ciberseguridad en Salud" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BJX4X9MFVK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-BJX4X9MFVK");
    </script>
    <script src="https://platform.linkedin.com/in.js" type="text/javascript" is:inline>lang: es_ES</script>
    <link rel="icon" type="image/png" href={`${basePath}assets/favicon/favicon-96x96.png`} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}assets/favicon/favicon.svg`} />
    <link rel="shortcut icon" href={`${basePath}assets/favicon/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${basePath}assets/favicon/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content="JCCS 2026" />
    <link rel="manifest" href={`${basePath}assets/favicon/site.webmanifest`} />
    <link rel="stylesheet" href={`${basePath}assets/css/ce44b9cb79c3c418.css`} />
    <link rel="stylesheet" href={`${basePath}assets/css/7625b12416c75fb2.css`} />
  </head>
  <body>
    <slot />
  </body>
</html>
