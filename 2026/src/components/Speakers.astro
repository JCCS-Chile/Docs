---
import speakers from "../data/speakers.json";
import PersonBio from "./PersonBio.astro";

const { basePath = "./" } = Astro.props;
const speakerOrder = [
  "michelle-bordachar.jpg",
  "felipe-harboe.jpg",
  "lorena-donoso.jpg",
  "joceyln-arteaga.jpg",
  "jose-fernandez.jpg",
  "cristian-donaire.jpg",
  "jaime-deloshoyos.jpg",
  "javier-mora.jpg",
  "narciso-basic.jpg",
  "dmtri-zaroubine.jpg",
  "jorge-herrera.jpg",
  "romina-torres.jpg",
  "ja-lecaros.jpg",
  "felix-liberona.jpg",
  "gabriel-bergel.jpg",
  "sebastian-vargas.jpg",
];
const speakersByPhoto = new Map(speakers.map((speaker) => [speaker.photo, speaker]));
const orderedSpeakers = speakerOrder.map((photo) => speakersByPhoto.get(photo)).filter(Boolean);
---

<div id="speakers" class="speakers-block" aria-labelledby="speakers-title">
  <div class="speakers-heading">
    <div class="section-label mb-5">Speakers</div>
    <h3 id="speakers-title" class="font-display font-extrabold text-3xl sm:text-4xl text-brand-900 leading-tight">
      Expertos que lideran <span class="gradient-text">la conversación</span>
    </h3>
  </div>

  <div class="speakers-grid">
    {orderedSpeakers.map((speaker) => (
      <article class="speaker-card">
        <div class="speaker-photo-wrap">
          <img
            class="speaker-photo"
            src={`${basePath}assets/images/speakers/${speaker.photo}`}
            alt={`Retrato de ${speaker.name}`}
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="speaker-details">
          <h4 class="speaker-name">
            {speaker.url ? (
              <a href={speaker.url} target="_blank" rel="noopener noreferrer" title={`Ver el perfil de ${speaker.name} en LinkedIn`}>
                {speaker.name}
              </a>
            ) : (
              speaker.name
            )}
          </h4>
          <p class="speaker-role">{speaker.role}</p>
          <PersonBio person={speaker} />
          {speaker.url && (
            <a class="team-profile-link" href={speaker.url} target="_blank" rel="noopener noreferrer">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</div>
