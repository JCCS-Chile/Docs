{
  "name": "jccs-2026-brochure",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Sitio JCCS 2026 mantenible con Astro + React Islands.",
  "scripts": {
    "sync": "python3 scripts/sync_from_export.py",
    "predev": "npm run sync",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "prebuild": "npm run sync",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "serve:legacy": "npm run sync && npx serve ."
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "astro": "^6.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "serve": "^14.2.4",
    "typescript": "^5.4.0"
  }
}
